# ============================================================
# TaskForge — Environment Variables Template
# Copy this to .env and fill in your local values.
# NEVER commit .env to git.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=taskforge
POSTGRES_PASSWORD=taskforge_dev_secret
POSTGRES_DB=taskforge
# Full DSN is constructed in docker-compose.yml from the above.
# For local non-Docker use, set this directly:
DATABASE_URL=postgresql+asyncpg://taskforge:taskforge_dev_secret@localhost:5432/taskforge

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- RabbitMQ ---
RABBITMQ_USER=taskforge
RABBITMQ_PASS=taskforge_dev_secret
RABBITMQ_VHOST=taskforge
RABBITMQ_URL=amqp://taskforge:taskforge_dev_secret@localhost:5672/taskforge

# --- JWT ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_generate_a_real_secret_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Worker ---
WORKER_CONCURRENCY=4
WORKER_HOSTNAME=worker-local

# --- Task Settings ---
TASK_MAX_ATTEMPTS_DEFAULT=5
TASK_EMAIL_TIMEOUT_SECONDS=30
TASK_IMAGE_RESIZE_TIMEOUT_SECONDS=60
TASK_WEBHOOK_TIMEOUT_SECONDS=30

# --- Rate Limiting ---
RATE_LIMIT_TASK_SUBMISSION_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=20

# --- Image Resize Handler ---
IMAGE_MAX_DIMENSION_PX=4096
IMAGE_MAX_RESPONSE_SIZE_MB=50

# --- Webhook Handler ---
WEBHOOK_MAX_RESPONSE_SIZE_KB=1024

# --- Email (SMTP) ---
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@taskforge.dev
