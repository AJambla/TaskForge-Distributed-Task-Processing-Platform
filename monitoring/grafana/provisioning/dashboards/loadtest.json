      "xaxis": {"mode": "time", "name": "Time", "show": true}
    },
    {
      "title": "Postgres Connection Pool Usage",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (datname) (pg_stat_activity_count{datname=\"taskforge\", state=\"active\"})",
          "legendFormat": "active connections",
          "refId": "A"
        },
        {
          "expr": "sum by (datname) (pg_stat_activity_count{datname=\"taskforge\", state=\"idle\"})",
          "legendFormat": "idle connections",
          "refId": "B"
        }
      ],
      "yaxes": [
        {"label": "connections", "format": "short"},
        {"format": "short", "label": null, "logBase": 1, "max": null, "min": null, "show": false}
      ],
      "xaxis": {"mode": "time", "name": "Time", "show": true},
      "thresholds": [
        {
          "colorMode": "critical",
          "fill": true,
          "line": true,
          "op": "gt",
          "value": 80,
          "yaxis": "left"
        }
      ]
    },
    {
      "title": "Worker Heartbeat Health",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(worker_heartbeat_missed_total[1m]))",
