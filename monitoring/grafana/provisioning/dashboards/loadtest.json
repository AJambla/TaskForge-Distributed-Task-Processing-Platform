{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "API Request Rate (tasks/sec)",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"taskforge-api\", handler=~\"/api/v1/tasks.*\"}[1m]))",
          "legendFormat": "tasks/sec",
          "refId": "A"
        }
      ],
      "yaxes": [
        {"label": "requests/s", "format": "short"},
        {"format": "short", "label": null, "logBase": 1, "max": null, "min": null, "show": false}
      ],
      "xaxis": {"mode": "time", "name": "Time", "show": true}
    },
    {
      "title": "API p99 Latency",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"taskforge-api\", handler=~\"/api/v1/tasks.*\"}[1m])) by (le, handler))",
          "legendFormat": "{{handler}} p99",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"taskforge-api\", handler=~\"/api/v1/tasks.*\"}[1m])) by (le, handler))",
          "legendFormat": "{{handler}} p95",
          "refId": "B"
        }
      ],
      "yaxes": [
        {"label": "seconds", "format": "short"},
        {"format": "short", "label": null, "logBase": 1, "max": null, "min": null, "show": false}
      ],
      "xaxis": {"mode": "time", "name": "Time", "show": true},
      "thresholds": [
        {
          "colorMode": "critical",
          "fill": true,
          "line": true,
          "op": "gt",
          "value": 0.5,
          "yaxis": "left"
        }
      ]
    },
    {
      "title": "Task Submission Success Rate",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"taskforge-api\", handler=~\"/api/v1/tasks.*\", status=~\"2..\"}[1m])) / sum(rate(http_requests_total{job=\"taskforge-api\", handler=~\"/api/v1/tasks.*\"}[1m])) * 100",
          "legendFormat": "success rate %",
          "refId": "A"
        }
      ],
      "yaxes": [
        {"label": "%", "format": "percent", "max": 100, "min": 0},
        {"format": "short", "label": null, "logBase": 1, "max": null, "min": null, "show": false}
      ],
      "xaxis": {"mode": "time", "name": "Time", "show": true}
    },
    {
      "title": "HTTP Error Rate (4xx/5xx)",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"taskforge-api\", handler=~\"/api/v1/tasks.*\", status=~\"4..\"}[1m]))",
          "legendFormat": "4xx",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_requests_total{job=\"taskforge-api\", handler=~\"/api/v1/tasks.*\", status=~\"5..\"}[1m]))",
          "legendFormat": "5xx",
          "refId": "B"
        }
      ],
      "yaxes": [
        {"label": "errors/s", "format": "short"},
        {"format": "short", "label": null, "logBase": 1, "max": null, "min": null, "show": false}
      ],
      "xaxis": {"mode": "time", "name": "Time", "show": true}
    },
    {
      "title": "Task Attempts Write Throughput",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(task_attempts_total[1m]))",
          "legendFormat": "attempts/sec",
          "refId": "A"
        },
        {
          "expr": "sum(rate(tasks_processed_total[1m]))",
          "legendFormat": "tasks processed/sec",
          "refId": "B"
        }
      ],
      "yaxes": [
        {"label": "ops/sec", "format": "short"},
        {"format": "short", "label": null, "logBase": 1, "max": null, "min": null, "show": false}
      ],
      "xaxis": {"mode": "time", "name": "Time", "show": true}
    },
    {
      "title": "RabbitMQ Queue Depth",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rabbitmq_queue_messages_ready",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        {"label": "messages", "format": "short"},
        {"format": "short", "label": null, "logBase": 1, "max": null, "min": null, "show": false}
