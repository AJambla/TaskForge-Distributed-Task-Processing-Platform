      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"taskforge-api\", handler=~\"/api/v1/tasks.*\"}[5m])) by (handler)",
          "legendFormat": "{{handler}}",
          "refId": "A"
        }
      ],
      "yaxes": [
        {"label": "requests/s", "format": "short"},
        {"format": "short", "label": null, "logBase": 1, "max": null, "min": null, "show": false}
      ],
      "xaxis": {"mode": "time", "name": "Time", "show": true}
    },
